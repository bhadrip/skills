{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/meal-prep/shopping-list.schema.json",
  "title": "Consolidated Shopping List",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "plan_id", "status", "items", "assumptions", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "minLength": 1},
    "plan_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "confirmed", "shopped"]},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "normalized_name", "display_name", "section", "buy_quantity", "buy_unit", "recipe_ids", "on_hand_status", "optional", "checked", "manually_added"],
        "properties": {
          "item_id": {"type": "string", "minLength": 1},
          "normalized_name": {"type": "string", "minLength": 1},
          "display_name": {"type": "string", "minLength": 1},
          "section": {"type": "string", "minLength": 1},
          "required_quantity": {"type": ["number", "string", "null"]},
          "required_unit": {"type": ["string", "null"]},
          "on_hand_quantity": {"type": ["number", "string", "null"]},
          "buy_quantity": {"type": ["number", "string", "null"]},
          "buy_unit": {"type": ["string", "null"]},
          "package_assumption": {"type": ["string", "null"]},
          "recipe_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "on_hand_status": {"enum": ["confirmed", "stale", "unknown", "none"]},
          "optional": {"type": "boolean"},
          "checked": {"type": "boolean"},
          "manually_added": {"type": "boolean"},
          "remainder_plan": {"type": ["string", "null"]}
        }
      }
    },
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
